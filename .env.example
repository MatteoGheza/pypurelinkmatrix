# PureLink Device Configuration
# Copy this file to .env and fill in your actual device credentials

# Device host (IP address or hostname)
PURELINK_HOST=127.0.0.1

# Device port (default: 80)
PURELINK_PORT=80

# Device login credentials
# Username: 1-15 alphanumeric characters and underscore
PURELINK_USERNAME=admin

# Password: 1-15 alphanumeric characters and underscore
PURELINK_PASSWORD=password

# Optional: Connection timeout in seconds (default: 30)
PURELINK_TIMEOUT=30

# Optional: Verify SSL certificates (default: true)
PURELINK_VERIFY_SSL=true
